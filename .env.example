# Telegram Bot Configuration
# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Default timezone for the bot (optional, defaults to UTC)
# Examples: America/New_York, Europe/London, Asia/Tokyo
DEFAULT_TIMEZONE=UTC

# Nominatim User Agent for geocoding (optional)
# Used by geopy to convert location names to coordinates
NOMINATIM_USER_AGENT=reminder-bot

# Database URL (optional, defaults to SQLite)
# SQLite (default): sqlite+aiosqlite:///data/reminders.db
# PostgreSQL example: postgresql+asyncpg://user:pass@localhost/reminders
DATABASE_URL=sqlite+aiosqlite:///data/reminders.db

# Logging level (optional, defaults to INFO)
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
